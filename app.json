{
  "expo": {
    "name": "RepairMatch",
    "slug": "repairmatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.utec.repairmatch"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c94a14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.edu.utec.repairmatch",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eae6df"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que RepairMatch use la cámara para fotografiar el electrodoméstico de tu solicitud.",
          "photosPermission": "Permite que RepairMatch seleccione una foto del electrodoméstico de tu galería.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RepairMatch usa tu ubicación para mostrar tu solicitud solo a técnicos de tu zona."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "repairmatch",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "973e2b87-271e-46b3-8840-a0578aa2fc52"
      }
    },
    "owner": "sebas.dev"
  }
}
