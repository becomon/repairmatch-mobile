# Optional default. On a phone, use the PC LAN address instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api
# Public configuration: never add a Cloudinary API secret or JWT here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# SDK 58: compatibilidad con archivos multipart por URI de React Native.
EXPO_PUBLIC_USE_RN_FETCH=1
